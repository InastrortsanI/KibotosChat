# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 Git에 올리면 안 됩니다)

# 기본으로 쓸 LLM: mock | gemini | claude | openai
# mock 은 API 키 없이 화면·DB 흐름을 테스트하는 가짜 응답기입니다.
LLM_PROVIDER=mock

# 키를 넣은 프로바이더만 화면의 모델 선택 목록에 나타납니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# DB 파일 위치와 로그인 유지 기간(일)
DATABASE_URL=sqlite:///./bluearchive_chat.db
TOKEN_DAYS=14

# 대화가 이 개수를 넘으면 오래된 부분을 요약해 '기억'으로 압축합니다.
SUMMARY_TRIGGER=30
KEEP_RECENT=12
